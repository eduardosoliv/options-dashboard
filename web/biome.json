{
  "$schema": "https://biomejs.dev/schemas/2.5.5/schema.json",
  "files": {
    "ignoreUnknown": true,
    "includes": ["**", "!dist", "!node_modules"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": { "preset": "recommended" }
  },
  "javascript": {
    "formatter": { "quoteStyle": "single", "jsxQuoteStyle": "double" }
  },
  "overrides": [
    {
      "includes": ["src/TradingDashboard.jsx"],
      "formatter": { "enabled": false },
      "linter": {
        "rules": {
          "correctness": {
            "useExhaustiveDependencies": "off",
            "useParseIntRadix": "off"
          },
          "style": { "useTemplate": "off" },
          "complexity": { "useOptionalChain": "off" },
          "a11y": { "useButtonType": "off" },
          "suspicious": { "noArrayIndexKey": "off" }
        }
      }
    }
  ]
}
